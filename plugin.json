{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "ue-angelscript-skills-for-codex",
	"version": "0.3.0",
	"description": "AngelScript gameplay, tests and EmmsUI",
	"author": {
		"name": "coquid",
		"url": "https://github.com/coquid"
	},
	"repository": "https://github.com/coquid/ue-angelscript-skills-plugin",
	"license": "MIT",
	"keywords": [
		"unreal-engine",
		"codex",
		"angelscript",
		"testing",
		"emmsui"
	],
	"extensions": {
		"com.openai": {
			"requires_local_executor": true,
			"interface": {
				"displayName": "UE AngelScript Skills",
				"shortDescription": "AngelScript gameplay, tests and EmmsUI",
				"longDescription": "Develop AngelScript gameplay, exercise world and PIE integration tests, and build EmmsUI developer interfaces using the target project's bindings.",
				"developerName": "coquid",
				"category": "Developer Tools",
				"capabilities": [
					"Read",
					"Write"
				],
				"defaultPrompt": [
					"Find the AngelScript bindings for the gameplay API in this project."
				]
			}
		}
	}
}
